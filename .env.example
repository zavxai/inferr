# =============================================================================
# inferr — environment variables  (SINGLE SOURCE OF TRUTH)
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored, so it NEVER travels with
# git — every machine keeps its own copy. That is exactly why ports used to
# drift: the value lived in many files and none of them were the boss.
#
# Set the block below and let EVERYTHING else be derived.
#
#   API_URL             public base URL of the API
#                         → Google callbacks, MCP issuer, WWW-Authenticate
#   FRONTEND_URL        public base URL of the web app
#                         → CORS origin + post-login redirect
#   NEXT_PUBLIC_API_URL what the browser uses to reach the API (must equal API_URL)
#   API_HOST_PORT       host port the API is published on
#                         → MUST equal your cloudflared tunnel target
#
# The production chain that has to line up:
#
#   cloudflared tunnel ──▶ http://localhost:${API_HOST_PORT}
#   docker-compose     ──▶ publishes ${API_HOST_PORT}:${API_PORT}
#   API_URL            ──▶ the public URL that tunnel serves
#   NEXT_PUBLIC_API_URL──▶ the URL the browser calls
#
# Run `bash scripts/preflight.sh` to verify the whole chain at once.
#
# ── LOCAL DEV example ────────────────────────────────────────────────────────
#   API_URL=http://localhost:4001
#   FRONTEND_URL=http://localhost:4000
#   NEXT_PUBLIC_API_URL=http://localhost:4001
#   API_HOST_PORT=4001          # 4001 keeps Docker clear of a native API on 3001
#
# ── PRODUCTION example (laptop + cloudflared tunnel) ─────────────────────────
#   API_URL=https://api.inferr.xyz
#   FRONTEND_URL=https://inferr.xyz
#   NEXT_PUBLIC_API_URL=https://api.inferr.xyz
#   API_HOST_PORT=3001          # must equal the tunnel's localhost port
# =============================================================================

# --- SINGLE SOURCE (change these; the rest is derived) ---
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_HOST_PORT=3001

# --- Container / internal ports (fixed; used inside the Docker network) ---
API_PORT=3001
DB_PORT=5432
WEB_PORT=4000
DB_HOST_PORT=5434

# --- Runtime ---
# Set to `production` on the server. Docker Compose overrides this to
# `development` for the api container unless you edit docker-compose.yml.
NODE_ENV=development

# --- Database ---
# Inside Docker, DB_HOST is forced to `postgres` and DB_PORT to `5432`.
# DATABASE_URL, when set, overrides the individual DB_* values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ai_feed
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASS=postgres
DB_NAME=ai_feed
DB_SSL=false

# --- Auth / secrets ---
JWT_SECRET=your-jwt-secret-key-change-in-production
SCRAPER_API_KEY=generate-a-secure-random-scraper-key

# --- Google OAuth ---
# The callback URLs are DERIVED from API_URL. Only set these to override.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=${API_URL}/auth/google/callback            # (derived)
# GOOGLE_MCP_CALLBACK_URL=${API_URL}/auth/google/mcp-callback    # (derived)
#
# IMPORTANT: whatever they resolve to must also be registered in
# Google Cloud Console → OAuth 2.0 Client → Authorized redirect URIs.

# --- Cache & queue (reserved; only used by the Kubernetes stack) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI APIs ---
OPENAI_API_KEY=

# --- Langfuse observability (optional; enabled when both keys are set) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- OpenTelemetry tracing (optional) ---
# Point this at the Jaeger OTLP HTTP receiver (see JAEGER_HTTP_PORT in compose).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=ai-feed-api
